{
  "name": "meta-editor",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/mcp-server",
    "packages/ingestion"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "ingest": "npm run ingest --workspace=packages/ingestion",
    "delete": "npm run delete --workspace=packages/ingestion",
    "build:prompts": "npx tsx scripts/build-prompt-content.ts",
    "smoke-test": "node scripts/smoke-test.mjs",
    "health-check": "node scripts/health-check.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "supabase": "^2.76.16"
  },
  "version": "0.0.2"
}
